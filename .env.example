# Telegram
BOT_TOKEN=123456:ABCDEF-your-token-from-BotFather

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_NLU_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Database (asyncpg DSN)
DATABASE_URL=postgresql://planner:planner@localhost:5432/planner

# Defaults
DEFAULT_TIMEZONE=Asia/Tashkent
DEFAULT_LANGUAGE=ru

# Logging
LOG_LEVEL=INFO

# Optional: comma-separated Telegram user_ids that may use the bot.
# Leave empty to allow everyone.
ALLOWED_USER_IDS=
